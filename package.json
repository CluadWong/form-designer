{
  "name": "ticket-designer",
  "private": false,
  "version": "0.1.4",
  "type": "module",
  "description": "固定布局表单设计器与渲染组件（Schema V2）：可视化编排版式 → 导出 Schema JSON → 渲染 / 填写 / 打印",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./designer": {
      "types": "./dist/designer.d.ts",
      "import": "./dist/designer.js"
    },
    "./renderer/style.css": "./dist/renderer-core.css",
    "./designer/style.css": "./dist/designer-ui.css",
    "./style.css": "./dist/ticket-designer.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "vue-tsc -p tsconfig.lib.json --declaration --emitDeclarationOnly --outDir dist && node scripts/fix-dts-alias.mjs",
    "pack:check": "npm run build:lib && npm run build:types && npm pack --dry-run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "bash scripts/release.sh"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "dompurify": "^3.4.14"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CluadWong/TicketDesigner.git"
  },
  "homepage": "https://github.com/CluadWong/TicketDesigner",
  "bugs": {
    "url": "https://github.com/CluadWong/TicketDesigner/issues"
  }
}
